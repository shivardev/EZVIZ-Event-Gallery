<service>
  <id>EZVIZMotionGif</id>
  <name>EZVIZ Motion GIF Worker</name>
  <description>Captures motion frames and groups them into animated GIF activity events.</description>
  <executable>%BASE%\..\runtime\Scripts\python.exe</executable>
  <arguments>"%BASE%\..\service_runner.py" motion_gif.py</arguments>
  <workingdirectory>%BASE%\..</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <stoptimeout>15 sec</stoptimeout>
  <onfailure action="restart" delay="5 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>5242880</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <zipDateFormat>yyyyMMdd</zipDateFormat>
  </log>
</service>
